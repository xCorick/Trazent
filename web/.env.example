# Copia este archivo como .env para configurar el entorno local.

# URL base de la API ASP.NET Core (sin "/" al final); las consultas van a <URL>/graphql.
VITE_API_URL=http://localhost:57930

# true  = usa los datos simulados de src/mocks (prototipo).
# false = llama a la API real con los servicios de src/services.
VITE_USE_MOCKS=true
